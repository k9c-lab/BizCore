@model BizCore.Models.ViewModels.PatientVisitFormViewModel

@{
    ViewData["Title"] = "ลงทะเบียนคนไข้";
    var patientInitState = Model.IsNewPatient ? "new" : Model.PatientId.HasValue ? "found" : "search";
    var selectedPatient = Model.PatientLookup.FirstOrDefault(x => x.PatientId == Model.PatientId);
    var selectedHospital = Model.CustomerLookup.FirstOrDefault(x => x.CustomerId == Model.CustomerId);
    var hospitalDisplayValue = selectedHospital != null
        ? $"{selectedHospital.CustomerCode} - {selectedHospital.CustomerName}"
        : (Model.ReferringHospital ?? string.Empty);
}

<div class="page-header">
    <div>
        <div class="page-eyebrow"><a asp-action="Index">ลงทะเบียนคนไข้</a></div>
        <h1 class="page-title">ลงทะเบียนใหม่</h1>
    </div>
</div>

<form asp-action="Create" method="post" id="visitForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="form-alert"></div>
    <input asp-for="BranchId" type="hidden" />

    <div class="form-shell">
        <div class="form-section quotation-header-section">
            <div class="form-section-title">ข้อมูลเอกสาร</div>
            <div class="row g-2 quotation-header-grid">
                <div class="col-lg-3 col-md-6">
                    <label asp-for="VN" class="form-label"></label>
                    <input asp-for="VN" class="form-control" readonly />
                    <div class="form-text">ระบบสร้างเลขที่ให้อัตโนมัติรายเดือน</div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label asp-for="VisitDate" class="form-label"></label>
                    <input asp-for="VisitDate" class="form-control" type="date" id="visitDateInput" />
                    <span asp-validation-for="VisitDate" class="text-danger"></span>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label">สาขา</label>
                    <div class="form-control readonly-detail">@Model.BranchName</div>
                </div>
            </div>
        </div>

        <div class="quotation-party-grid">
            <div class="quotation-party-column">
                <div class="quotation-info-card">
                    <div class="quotation-info-card-title">ข้อมูลคนไข้ <span class="text-danger">*</span></div>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <button type="button" id="btnReadCard" class="btn btn-sm btn-outline-info" disabled>
                            อ่านบัตรประชาชน
                        </button>
                        <span id="cardReaderStatus" class="text-muted small">กำลังเชื่อมต่อเครื่องอ่านบัตร...</span>
                    </div>

                    <input asp-for="PatientId" type="hidden" id="visitPatientId" />
                    <input asp-for="IsNewPatient" type="hidden" id="isNewPatientInput" />

                    @* SEARCH STATE *@
                    <div id="pt-search" class="@(patientInitState == "search" ? "" : "d-none")">
                        <div class="search-dropdown mb-1">
                            <input type="text" class="form-control" id="visitPatientSearch"
                                   placeholder="พิมพ์เลขบัตร ปชช., HN หรือชื่อ-นามสกุล"
                                   autocomplete="off" />
                            <div id="visitPatientResults" class="search-dropdown-menu" style="display:none;"></div>
                        </div>
                        <div class="form-text">ถ้าไม่พบให้เลือก "สร้างคนไข้ใหม่" ในรายการ</div>
                    </div>

                    @* FOUND STATE *@
                    <div id="pt-found" class="@(patientInitState == "found" ? "" : "d-none")">
                        <div class="quotation-info-grid">
                            <div class="quotation-info-field">
                                <span class="quotation-info-label">HN</span>
                                <span class="quotation-info-value" id="patientHN">@(selectedPatient?.HN ?? "-")</span>
                            </div>
                            <div class="quotation-info-field">
                                <span class="quotation-info-label">เพศ</span>
                                <span class="quotation-info-value" id="patientGender">@(selectedPatient?.Gender == "M" ? "ชาย" : selectedPatient?.Gender == "F" ? "หญิง" : "-")</span>
                            </div>
                        </div>
                        <div class="quotation-info-grid">
                            <div class="quotation-info-field">
                                <span class="quotation-info-label">ชื่อ-นามสกุล</span>
                                <span class="quotation-info-value" id="patientFullName">@(selectedPatient?.FullName ?? "-")</span>
                            </div>
                            <div class="quotation-info-field">
                                <span class="quotation-info-label">วันเกิด</span>
                                <span class="quotation-info-value" id="patientDOB">@(selectedPatient?.DateOfBirth ?? "-")</span>
                                <span class="text-muted small" id="patientAge"></span>
                            </div>
                        </div>
                        <div class="quotation-info-field">
                            <span class="quotation-info-label">โทรศัพท์</span>
                            <span class="quotation-info-value" id="patientPhone">@(selectedPatient?.Phone ?? "-")</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="patientReset()">เปลี่ยนคนไข้</button>
                    </div>

                    @* NEW PATIENT STATE *@
                    <div id="pt-new" class="@(patientInitState == "new" ? "" : "d-none")">
                        <div class="workflow-info workflow-info-warning py-2 mb-2" style="font-size:0.85rem;">
                            ไม่พบในระบบ — กรอกข้อมูลเพื่อสร้างคนไข้ใหม่
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label form-label-sm">HN <span class="text-danger">*</span></label>
                                <input asp-for="NewPatientHN" class="form-control form-control-sm" placeholder="เลข HN จาก รพ.ที่ส่งตัว" />
                                <span asp-validation-for="NewPatientHN" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm">เลขบัตร ปชช.</label>
                                <input asp-for="NewPatientNationalId" class="form-control form-control-sm" id="newPatientNationalId" />
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm">ชื่อ <span class="text-danger">*</span></label>
                                <input asp-for="NewPatientFirstName" class="form-control form-control-sm" />
                                <span asp-validation-for="NewPatientFirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm">นามสกุล <span class="text-danger">*</span></label>
                                <input asp-for="NewPatientLastName" class="form-control form-control-sm" />
                                <span asp-validation-for="NewPatientLastName" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm">เพศ</label>
                                <select asp-for="NewPatientGender" class="form-select form-select-sm">
                                    <option value="">-</option>
                                    <option value="M">ชาย</option>
                                    <option value="F">หญิง</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm">วันเกิด</label>
                                <input type="text" class="form-control form-control-sm" id="NewPatientDateOfBirth_display"
                                       placeholder="วว/ดด/ปปปป" maxlength="10" autocomplete="off" inputmode="numeric" />
                                <input type="hidden" id="NewPatientDateOfBirth" name="NewPatientDateOfBirth"
                                       value="@(Model.NewPatientDateOfBirth?.ToString("yyyy-MM-dd") ?? "")" />
                                <span id="newPatientAge" class="form-text text-muted"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label form-label-sm">โทรศัพท์</label>
                                <input asp-for="NewPatientPhone" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="patientReset()">ยกเลิก / ค้นหาใหม่</button>
                    </div>

                    <span asp-validation-for="PatientId" class="text-danger d-block mt-1"></span>
                </div>
            </div>

        </div>

        <div class="form-section">
            <div class="form-section-title">ข้อมูลการเยี่ยม</div>
            <div class="row g-2">
                <div class="col-lg-2 col-md-4">
                    <label asp-for="Weight" class="form-label"></label>
                    <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label asp-for="Height" class="form-label"></label>
                    <input asp-for="Height" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Height" class="text-danger"></span>
                </div>
                <div class="col-lg-3 col-md-4">
                    <label asp-for="Ward" class="form-label"></label>
                    <input asp-for="Ward" class="form-control" />
                    <span asp-validation-for="Ward" class="text-danger"></span>
                </div>
                <div class="col-lg-5 col-md-6">
                    <label class="form-label">โรงพยาบาลส่งตัว <small class="text-muted">(ผู้รับบิล)</small></label>
                    <input asp-for="CustomerId" type="hidden" id="visitHospitalCustomerId" />
                    <input asp-for="ReferringHospital" type="hidden" id="visitReferringHospital" />
                    <div class="search-dropdown">
                        <input type="text" class="form-control" id="visitHospitalSearch"
                               placeholder="ค้นหา รพ. หรือองค์กรผู้ส่งตัว"
                               value="@hospitalDisplayValue"
                               autocomplete="off" />
                        <div id="visitHospitalResults" class="search-dropdown-menu" style="display:none;"></div>
                    </div>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>
                <div class="col-lg-4 col-md-6">
                    <label asp-for="TreatmentRightId" class="form-label"></label>
                    <select asp-for="TreatmentRightId" asp-items="Model.TreatmentRightOptions" class="form-select">
                        <option value="">เลือกสิทธิการรักษา</option>
                    </select>
                    <span asp-validation-for="TreatmentRightId" class="text-danger"></span>
                </div>
                <div class="col-lg-4 col-md-6">
                    <label asp-for="ReferringDoctorId" class="form-label"></label>
                    <select asp-for="ReferringDoctorId" asp-items="Model.ReferringDoctorOptions" class="form-select" id="visitReferringDoctorSelect">
                        <option value="">เลือกแพทย์ส่ง</option>
                    </select>
                    <span asp-validation-for="ReferringDoctorId" class="text-danger"></span>
                </div>
                <div class="col-lg-8">
                    <label asp-for="Remark" class="form-label"></label>
                    <textarea asp-for="Remark" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Remark" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="table-card-header px-0 pt-0">
                <div>
                    <h2 class="section-title">รายการตรวจ</h2>
                    <p class="section-subtitle">เพิ่มรายการบริการที่คนไข้ต้องการตรวจ</p>
                </div>
            </div>
            <div class="mb-2">
                <div class="search-dropdown">
                    <input type="text" class="form-control" id="itemSearchInput" placeholder="ค้นหารายการตรวจ (รหัสหรือชื่อ)" autocomplete="off" />
                    <div id="itemSearchResults" class="search-dropdown-menu" style="display:none;"></div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table entity-table align-middle" id="visitItemsTable">
                    <thead>
                        <tr>
                            <th>รหัส</th>
                            <th>ชื่อรายการ</th>
                            <th>หน่วย</th>
                            <th style="width:130px;">จำนวน</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="visitItemsBody">
                    </tbody>
                </table>
            </div>
            <div id="visitItemsEmpty" class="table-empty text-center py-3">ยังไม่มีรายการตรวจ — ค้นหาและเลือกรายการด้านบน</div>
        </div>
    </div>

    <div class="form-actions mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
        <button type="submit" class="btn btn-primary">บันทึกการลงทะเบียน</button>
    </div>
</form>

<script type="application/json" id="patientLookupData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PatientLookup))</script>
<script type="application/json" id="itemLookupData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ItemLookup))</script>
<script type="application/json" id="existingItemsData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(x => new { x.ItemId, x.ItemCode, x.ItemName, x.Unit, x.Quantity })))</script>
<script type="application/json" id="customerLookupData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CustomerLookup))</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        // ---- Data ----
        const patients = JSON.parse(document.getElementById('patientLookupData').textContent);
        const items = JSON.parse(document.getElementById('itemLookupData').textContent);
        let visitItems = JSON.parse(document.getElementById('existingItemsData').textContent) || [];

        // ---- Patient State Machine ----
        const ptSearch = document.getElementById('pt-search');
        const ptFound = document.getElementById('pt-found');
        const ptNew = document.getElementById('pt-new');
        const patientIdInput = document.getElementById('visitPatientId');
        const isNewPatientInput = document.getElementById('isNewPatientInput');
        const patientSearchInput = document.getElementById('visitPatientSearch');
        const patientDropdown = document.getElementById('visitPatientResults');

        function showPatientState(state) {
            ptSearch.classList.toggle('d-none', state !== 'search');
            ptFound.classList.toggle('d-none', state !== 'found');
            ptNew.classList.toggle('d-none', state !== 'new');
            isNewPatientInput.value = state === 'new' ? 'true' : 'false';
            if (state !== 'found') patientIdInput.value = '';
        }

        function calcAge(iso) {
            if (!iso) return '';
            var d = new Date(iso), t = new Date();
            var age = t.getFullYear() - d.getFullYear();
            if (t.getMonth() < d.getMonth() || (t.getMonth() === d.getMonth() && t.getDate() < d.getDate())) age--;
            return age >= 0 ? 'อายุ ' + age + ' ปี' : '';
        }

        window.patientReset = function () {
            showPatientState('search');
            patientSearchInput.value = '';
            patientDropdown.style.display = 'none';
            setTimeout(() => patientSearchInput.focus(), 50);
        };

        function selectPatient(p) {
            patientIdInput.value = p.PatientId;
            document.getElementById('patientHN').textContent = p.HN;
            document.getElementById('patientFullName').textContent = p.FullName || '-';
            document.getElementById('patientGender').textContent = p.Gender === 'M' ? 'ชาย' : p.Gender === 'F' ? 'หญิง' : '-';
            document.getElementById('patientDOB').textContent = (function(iso) {
                if (!iso) return '-';
                var p = iso.split('-');
                return p.length === 3 ? p[2] + '/' + p[1] + '/' + (parseInt(p[0], 10) + 543) : iso;
            })(p.DateOfBirth);
            document.getElementById('patientPhone').textContent = p.Phone || '-';
            document.getElementById('patientAge').textContent = calcAge(p.DateOfBirth);
            showPatientState('found');
            patientDropdown.style.display = 'none';
        }

        function renderPatientDropdown(keyword) {
            const kw = keyword.trim().toLowerCase();
            const matches = kw.length < 1 ? [] : patients.filter(p =>
                p.HN.toLowerCase().includes(kw) ||
                p.FullName.toLowerCase().includes(kw) ||
                (p.NationalId && p.NationalId.includes(kw))
            ).slice(0, 10);

            const rows = matches.map((p, i) =>
                `<div class="search-dropdown-item" data-idx="${i}">${esc(p.HN)} — ${esc(p.FullName)}</div>`
            );
            rows.push(`<div class="search-dropdown-item" data-action="new" style="color:var(--bs-primary);border-top:1px solid var(--bs-border-color);margin-top:2px;padding-top:6px;">+ ไม่พบในระบบ → สร้างคนไข้ใหม่</div>`);

            patientDropdown.innerHTML = rows.join('');
            patientDropdown.style.display = '';

            patientDropdown.querySelectorAll('[data-idx]').forEach(el => {
                el.addEventListener('mousedown', e => {
                    e.preventDefault();
                    selectPatient(matches[+el.dataset.idx]);
                });
            });
            patientDropdown.querySelector('[data-action="new"]').addEventListener('mousedown', e => {
                e.preventDefault();
                const nationalIdEl = document.getElementById('newPatientNationalId');
                if (nationalIdEl) nationalIdEl.value = patientSearchInput.value.trim();
                showPatientState('new');
                patientDropdown.style.display = 'none';
            });
        }

        if (patientSearchInput) {
            patientSearchInput.addEventListener('input', function () {
                if (this.value.trim().length < 1) { patientDropdown.style.display = 'none'; return; }
                renderPatientDropdown(this.value);
            });
            patientSearchInput.addEventListener('blur', () => setTimeout(() => { patientDropdown.style.display = 'none'; }, 150));
        }

        // ---- Item Search ----
        setupSearch(
            document.getElementById('itemSearchInput'),
            document.getElementById('itemSearchResults'),
            items,
            (i) => `${i.ItemCode} - ${i.ItemName}`,
            (i) => {
                addItem(i);
                document.getElementById('itemSearchInput').value = '';
            },
            (keyword) => items.filter(i =>
                i.ItemCode.toLowerCase().includes(keyword) ||
                i.ItemName.toLowerCase().includes(keyword)
            )
        );

        // ---- Items Table ----
        function addItem(item) {
            visitItems.push({ ItemId: item.ItemId, ItemCode: item.ItemCode, ItemName: item.ItemName, Unit: item.Unit, Quantity: 1 });
            renderItems();
        }

        function removeItem(index) {
            visitItems.splice(index, 1);
            renderItems();
        }

        function renderItems() {
            const tbody = document.getElementById('visitItemsBody');
            const empty = document.getElementById('visitItemsEmpty');
            tbody.innerHTML = '';

            if (visitItems.length === 0) {
                empty.style.display = '';
                document.getElementById('visitItemsTable').style.display = 'none';
                return;
            }

            empty.style.display = 'none';
            document.getElementById('visitItemsTable').style.display = '';

            visitItems.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><input type="hidden" name="Items[${index}].ItemId" value="${item.ItemId}" /><span class="code-chip">${esc(item.ItemCode)}</span></td>
                    <td>${esc(item.ItemName)}</td>
                    <td>${esc(item.Unit)}</td>
                    <td><input type="number" name="Items[${index}].Quantity" value="${item.Quantity}" min="0.01" step="0.01" class="form-control form-control-sm" onchange="updateQty(${index}, this.value)" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItemAt(${index})">ลบ</button></td>
                `;
                tbody.appendChild(tr);
            });
        }

        window.removeItemAt = removeItem;
        window.updateQty = function (index, val) {
            visitItems[index].Quantity = parseFloat(val) || 1;
        };

        function esc(str) {
            return (str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        // ---- Generic Search Dropdown ----
        function setupSearch(input, dropdown, data, labelFn, onSelect, filterFn) {
            input.addEventListener('input', function () {
                const keyword = this.value.trim().toLowerCase();
                if (keyword.length < 1) { dropdown.style.display = 'none'; return; }
                const results = filterFn(keyword).slice(0, 10);
                if (results.length === 0) { dropdown.style.display = 'none'; return; }
                dropdown.innerHTML = results.map((item, i) =>
                    `<div class="search-dropdown-item" data-index="${i}">${esc(labelFn(item))}</div>`
                ).join('');
                dropdown.style.display = '';
                dropdown.querySelectorAll('.search-dropdown-item').forEach((el, i) => {
                    el.addEventListener('mousedown', (e) => {
                        e.preventDefault();
                        onSelect(results[i]);
                        input.value = labelFn(results[i]);
                        dropdown.style.display = 'none';
                    });
                });
            });
            input.addEventListener('blur', () => setTimeout(() => { dropdown.style.display = 'none'; }, 150));
        }

        // ---- VN update on date change ----
        document.getElementById('visitDateInput').addEventListener('change', async function () {
            const date = this.value;
            if (!date) return;
            try {
                const res = await fetch(`/PatientVisits/NextVN?date=${encodeURIComponent(date)}`);
                if (!res.ok) return;
                const data = await res.json();
                if (data.vn) document.getElementById('VN').value = data.vn;
            } catch { }
        });

        renderItems();

        // ---- Hospital / Billing Customer Search ----
        (function () {
            const customers = JSON.parse(document.getElementById('customerLookupData').textContent);
            const searchInput = document.getElementById('visitHospitalSearch');
            const resultsEl = document.getElementById('visitHospitalResults');
            const custIdInput = document.getElementById('visitHospitalCustomerId');
            const refHospInput = document.getElementById('visitReferringHospital');
            if (!searchInput) return;

            function renderHospitalResults(keyword) {
                const kw = (keyword || '').trim().toLowerCase();
                const matches = (kw.length < 1 ? customers : customers.filter(c =>
                    c.CustomerCode.toLowerCase().includes(kw) ||
                    c.CustomerName.toLowerCase().includes(kw)
                )).slice(0, 15);
                if (!matches.length) { resultsEl.style.display = 'none'; return; }
                resultsEl.innerHTML = matches.map(c =>
                    `<div class="search-dropdown-item" data-id="${c.CustomerId}">${esc(c.CustomerCode)} — ${esc(c.CustomerName)}</div>`
                ).join('');
                resultsEl.style.display = '';
                resultsEl.querySelectorAll('.search-dropdown-item').forEach(el => {
                    el.addEventListener('mousedown', e => {
                        e.preventDefault();
                        const c = matches.find(x => x.CustomerId == el.dataset.id);
                        if (!c) return;
                        custIdInput.value = c.CustomerId;
                        refHospInput.value = c.CustomerName;
                        searchInput.value = `${c.CustomerCode} — ${c.CustomerName}`;
                        resultsEl.style.display = 'none';
                    });
                });
            }

            searchInput.addEventListener('focus', () => renderHospitalResults(searchInput.value));
            searchInput.addEventListener('input', function () {
                custIdInput.value = '';
                refHospInput.value = this.value;
                renderHospitalResults(this.value);
            });
            searchInput.addEventListener('blur', () => {
                setTimeout(() => { resultsEl.style.display = 'none'; }, 150);
            });
        })();

        // ---- Referring Doctor Search ----
        (function () {
            const select = document.getElementById('visitReferringDoctorSelect');
            if (!select) return;

            const options = [...select.options]
                .filter(o => o.value)
                .map(o => ({ id: o.value, text: o.text, search: o.text.toLowerCase() }));

            select.classList.add('d-none');

            const wrapper = document.createElement('div');
            wrapper.className = 'search-dropdown';

            const searchInput = document.createElement('input');
            searchInput.type = 'text';
            searchInput.className = 'form-control';
            searchInput.placeholder = 'ค้นหาจากรหัสหรือชื่อแพทย์ส่ง';
            searchInput.autocomplete = 'off';

            const resultsEl = document.createElement('div');
            resultsEl.className = 'search-dropdown-menu';
            resultsEl.style.display = 'none';

            wrapper.appendChild(searchInput);
            wrapper.appendChild(resultsEl);
            select.insertAdjacentElement('afterend', wrapper);

            if (select.value) {
                const current = options.find(o => o.id === select.value);
                if (current) searchInput.value = current.text;
            }

            function renderResults(keyword) {
                const kw = (keyword || '').trim().toLowerCase();
                const matches = options.filter(o => !kw || o.search.includes(kw)).slice(0, 15);
                if (!matches.length) { resultsEl.style.display = 'none'; return; }
                resultsEl.innerHTML = matches.map(o =>
                    `<div class="search-dropdown-item" data-id="${o.id}">${esc(o.text)}</div>`
                ).join('');
                resultsEl.style.display = '';
                resultsEl.querySelectorAll('.search-dropdown-item').forEach(el => {
                    el.addEventListener('mousedown', e => {
                        e.preventDefault();
                        const opt = options.find(o => o.id === el.dataset.id);
                        if (!opt) return;
                        select.value = opt.id;
                        searchInput.value = opt.text;
                        resultsEl.style.display = 'none';
                    });
                });
            }

            searchInput.addEventListener('focus', () => renderResults(searchInput.value));
            searchInput.addEventListener('input', () => { select.value = ''; renderResults(searchInput.value); });
            searchInput.addEventListener('blur', () => {
                setTimeout(() => {
                    resultsEl.style.display = 'none';
                    if (!select.value) searchInput.value = '';
                }, 150);
            });
        })();

        // ---- ID Card Reader ----
        (function () {
            var ws = null;
            var connected = false;
            var readerList = null;
            var selectRes = null;
            var readRes = null;
            var readerSelected = false;

            var statusEl = document.getElementById('cardReaderStatus');
            var readBtn = document.getElementById('btnReadCard');

            function setStatus(ok) {
                connected = ok;
                if (statusEl) {
                    statusEl.textContent = ok ? 'เครื่องอ่านบัตร: พร้อม' : 'เครื่องอ่านบัตร: ไม่พบการเชื่อมต่อ';
                    statusEl.className = ok ? 'text-success small' : 'text-danger small';
                }
                if (readBtn) readBtn.disabled = !ok;
            }

            function wsSend(obj) { ws.send(JSON.stringify(obj)); }

            function onMessage(msg) {
                if (msg.Message === 'AgentStatusE' && msg.Status === 1) setStatus(true);
                if (msg.Message === 'GetReaderListR') readerList = msg.Status > 0 ? msg.ReaderList : [];
                if (msg.Message === 'SelectReaderR') {
                    selectRes = parseInt(msg.Status) >= 0;
                    if (selectRes) readerSelected = true;
                }
                if (msg.Message === 'ReadIDCardR') {
                    readRes = msg.Status;
                    if (msg.Status === 0) fillFromCard(msg);
                }
            }

            function wait(check, ms) {
                return new Promise(function (resolve) {
                    var t = setTimeout(resolve, ms);
                    var iv = setInterval(function () {
                        if (check()) { clearInterval(iv); clearTimeout(t); resolve(); }
                    }, 100);
                });
            }

            async function readCard() {
                if (!connected) return;
                readerList = null; selectRes = null; readRes = null; readerSelected = false;
                readBtn.disabled = true;
                readBtn.textContent = 'กำลังอ่าน...';

                wsSend({ Command: 'GetReaderList' });
                await wait(function () { return readerList !== null; }, 5000);

                if (!readerList || readerList.length === 0) {
                    alert('ไม่พบเครื่องอ่านบัตร กรุณาตรวจสอบการเชื่อมต่อ');
                    resetBtn(); return;
                }

                for (var i = 0; i < readerList.length; i++) {
                    selectRes = null;
                    wsSend({ Command: 'SelectReader', ReaderName: readerList[i] });
                    await wait(function () { return selectRes !== null; }, 5000);
                    if (!selectRes) continue;

                    readRes = null;
                    wsSend({ Command: 'ReadIDCard', IDNumberRead: false, IDTextRead: false, IDATextRead: true, IDPhotoRead: false });
                    await wait(function () { return readRes !== null; }, 30000);

                    if (readRes !== -16) break;
                }

                if (readRes === -16 || readRes === null)
                    alert('ไม่พบบัตรในเครื่องอ่าน กรุณาใส่บัตรแล้วลองใหม่');

                resetBtn();
            }

            function resetBtn() {
                readBtn.disabled = !connected;
                readBtn.textContent = 'อ่านบัตรประชาชน';
            }

            function fillFromCard(msg) {
                var raw = msg.IDAText || msg.IDText || '';
                if (!raw) return;
                var d = raw.split('#');
                if (d.length < 19) return;

                var nationalId  = (d[0] || '').trim();
                var firstName   = (d[2] || '').trim();
                var lastName    = (d[4] || '').trim();
                var genderCode  = d[17];
                var dobRaw      = (d[18] || '').trim(); // yyyymmdd BE

                var gender = genderCode === '1' ? 'M' : genderCode === '2' ? 'F' : '';

                // ค้นหาคนไข้เดิมในระบบจากเลขบัตร
                var existing = patients.find(function (p) { return p.NationalId === nationalId; });
                if (existing) {
                    selectPatient(existing);
                    return;
                }

                // ไม่พบ → เปิด new patient และเติมข้อมูล
                showPatientState('new');

                var setVal = function (id, val) {
                    var el = document.getElementById(id) || document.querySelector('[name="' + id + '"]');
                    if (el) el.value = val;
                };

                setVal('newPatientNationalId', nationalId);
                setVal('NewPatientFirstName', firstName);
                setVal('NewPatientLastName', lastName);
                setVal('NewPatientGender', gender);

                if (dobRaw.length >= 8) {
                    var beYear = parseInt(dobRaw.substring(0, 4), 10);
                    var mo = dobRaw.substring(4, 6);
                    var dy = dobRaw.substring(6, 8);
                    var display = document.getElementById('NewPatientDateOfBirth_display');
                    var hidden  = document.getElementById('NewPatientDateOfBirth');
                    var isoVal = (beYear - 543) + '-' + mo + '-' + dy;
                    if (display) display.value = dy + '/' + mo + '/' + beYear;
                    if (hidden)  hidden.value  = isoVal;
                    var ageEl = document.getElementById('newPatientAge');
                    if (ageEl) ageEl.textContent = calcAge(isoVal);
                }
            }

            function connect() {
                ws = new WebSocket('ws://localhost:14820/IDWAgent');
                ws.onmessage = function (e) { onMessage(JSON.parse(e.data)); };
                ws.onclose = function () { setStatus(false); };
                ws.onerror = function () { setStatus(false); };
            }

            if (readBtn) readBtn.addEventListener('click', readCard);
            window.addEventListener('beforeunload', function () { if (ws) ws.close(); });
            connect();
        })();

        // ---- New Patient Date of Birth mask (วว/ดด/ปปปป BE) ----
        (function () {
            var display = document.getElementById('NewPatientDateOfBirth_display');
            var hidden  = document.getElementById('NewPatientDateOfBirth');
            if (!display || !hidden) return;

            function isoToBe(iso) {
                if (!iso) return '';
                var p = iso.split('-');
                if (p.length !== 3) return '';
                return p[2] + '/' + p[1] + '/' + (parseInt(p[0], 10) + 543);
            }
            function beToIso(be) {
                if (!be || be.length !== 10) return '';
                var p = be.split('/');
                if (p.length !== 3) return '';
                var y = parseInt(p[2], 10);
                if (isNaN(y) || y < 543) return '';
                return (y - 543) + '-' + p[1].padStart(2, '0') + '-' + p[0].padStart(2, '0');
            }
            function sync() {
                hidden.value = display.value.length === 10 ? (beToIso(display.value) || '') : '';
                var ageEl = document.getElementById('newPatientAge');
                if (ageEl) ageEl.textContent = hidden.value ? calcAge(hidden.value) : '';
            }

            display.addEventListener('keydown', function (e) {
                var allowed = ['Backspace', 'Delete', 'Tab', 'Escape', 'Enter', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'];
                if (allowed.indexOf(e.key) >= 0) return;
                if (!/^\d$/.test(e.key)) e.preventDefault();
            });
            display.addEventListener('input', function () {
                var digits = display.value.replace(/\D/g, '').substring(0, 8);
                var result = digits.substring(0, 2);
                if (digits.length >= 3) result += '/' + digits.substring(2, 4);
                if (digits.length >= 5) result += '/' + digits.substring(4, 8);
                display.value = result;
                sync();
            });
            display.addEventListener('change', sync);

            if (hidden.value) display.value = isoToBe(hidden.value);
        })();
    })();
    </script>
}
