@model BizCore.Models.Entities.Patient

@{
    ViewData["Title"] = "เพิ่มคนไข้";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow"><a asp-action="Index">คนไข้</a></div>
        <h1 class="page-title">เพิ่มคนไข้</h1>
    </div>
</div>

<div class="card content-card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
            <div class="form-actions mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
                <button type="submit" class="btn btn-primary">บันทึก</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
