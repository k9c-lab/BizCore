@model BizCore.Models.Entities.Patient

<div asp-validation-summary="All" class="form-alert"></div>

<div class="form-shell">
    <div class="form-section quotation-header-section">
        <div class="form-section-title">ข้อมูลคนไข้</div>
        <div class="row g-2 quotation-header-grid">
            <div class="col-lg-2 col-md-4">
                <label asp-for="HN" class="form-label"></label>
                <input asp-for="HN" class="form-control" placeholder="เช่น HN-00001" />
                <div class="form-text">HN จากโรงพยาบาลต้นสังกัด</div>
                <span asp-validation-for="HN" class="text-danger"></span>
            </div>
            <div class="col-lg-3 col-md-4">
                <label asp-for="NationalId" class="form-label"></label>
                <input asp-for="NationalId" class="form-control" placeholder="เลข 13 หลัก" />
                <span asp-validation-for="NationalId" class="text-danger"></span>
            </div>
            <div class="col-lg-2 col-md-4">
                <label asp-for="Gender" class="form-label"></label>
                <select asp-for="Gender" class="form-select">
                    <option value="">ไม่ระบุ</option>
                    <option value="M">ชาย</option>
                    <option value="F">หญิง</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
            <div class="col-lg-2 col-md-4">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input type="text" class="form-control" id="DateOfBirth_display"
                       placeholder="วว/ดด/ปปปป" maxlength="10" autocomplete="off" inputmode="numeric" />
                <input type="hidden" id="DateOfBirth" name="DateOfBirth"
                       value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")" />
                <span id="ageDisplay" class="form-text text-muted"></span>
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>
            <div class="col-lg-3 col-md-4">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-lg-3 col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col-lg-3 col-md-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="col-lg-6">
                <label asp-for="Address" class="form-label"></label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">สถานะ</label>
                <label class="quotation-inline-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <span>ใช้งานอยู่</span>
                </label>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var display = document.getElementById('DateOfBirth_display');
    var hidden  = document.getElementById('DateOfBirth');
    if (!display || !hidden) return;

    function isoToBe(iso) {
        if (!iso) return '';
        var p = iso.split('-');
        if (p.length !== 3) return '';
        return p[2] + '/' + p[1] + '/' + (parseInt(p[0], 10) + 543);
    }
    function beToIso(be) {
        if (!be || be.length !== 10) return '';
        var p = be.split('/');
        if (p.length !== 3) return '';
        var y = parseInt(p[2], 10);
        if (isNaN(y) || y < 543) return '';
        return (y - 543) + '-' + p[1].padStart(2, '0') + '-' + p[0].padStart(2, '0');
    }
    function calcAge(iso) {
        if (!iso) return '';
        var d = new Date(iso), t = new Date();
        var age = t.getFullYear() - d.getFullYear();
        if (t.getMonth() < d.getMonth() || (t.getMonth() === d.getMonth() && t.getDate() < d.getDate())) age--;
        return age >= 0 ? 'อายุ ' + age + ' ปี' : '';
    }
    function sync() {
        hidden.value = display.value.length === 10 ? (beToIso(display.value) || '') : '';
        var ageEl = document.getElementById('ageDisplay');
        if (ageEl) ageEl.textContent = calcAge(hidden.value);
    }

    display.addEventListener('keydown', function (e) {
        var allowed = ['Backspace', 'Delete', 'Tab', 'Escape', 'Enter', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'];
        if (allowed.indexOf(e.key) >= 0) return;
        if (!/^\d$/.test(e.key)) e.preventDefault();
    });
    display.addEventListener('input', function () {
        var digits = display.value.replace(/\D/g, '').substring(0, 8);
        var result = digits.substring(0, 2);
        if (digits.length >= 3) result += '/' + digits.substring(2, 4);
        if (digits.length >= 5) result += '/' + digits.substring(4, 8);
        display.value = result;
        sync();
    });
    display.addEventListener('change', sync);

    if (hidden.value) { display.value = isoToBe(hidden.value); sync(); }
})();
</script>
